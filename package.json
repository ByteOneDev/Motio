{
  "name": "motio",
  "productName": "Motio",
  "version": "0.1.0",
  "description": "Motion design simple pour tutoriels et trailers",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --mac --arm64",
    "dist:dir": "electron-vite build && electron-builder --mac --arm64 --dir"
  },
  "devDependencies": {
    "@fontsource-variable/caveat": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/montserrat": "5.3.0",
    "@fontsource-variable/oswald": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/pacifico": "5.3.0",
    "@fontsource/permanent-marker": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "immer": "11.1.21",
    "lucide-react": "1.55.0",
    "mediabunny": "1.60.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "author": "Motio"
